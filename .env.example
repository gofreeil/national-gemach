# Strapi backend (משותף עם אתר "קהילה בשכונה")
# שני האתרים חייבים להצביע לאותו Strapi
STRAPI_URL=https://your-strapi-instance.example.com
STRAPI_TOKEN=your-strapi-api-token-with-full-access

# ── פאנל ניהול: הרשאות ─────────────────────────────────────────
# מי אדמין/סופר-אדמין. מזהים מופרדים בפסיק — אימייל / שם משתמש / טלפון.
# תמיד גובר על רשימת ה-DB, ומבטיח גישה גם כשה-DB ריק.
NG_SUPER_ADMINS=yahavanter@gmail.com
NG_ADMINS=
# בעלי האתר — מסך הקטגוריות שמור לו בלבד, גם מול סופר-אדמינים אחרים.
NG_OWNER=yahavanter@gmail.com

# ── מונה גולשים (Google Analytics) ─────────────────────────────
# 1) מזהה המדידה של GA4 (G-XXXXXXXXXX) — מטעין את gtag בצד-הלקוח.
GA_MEASUREMENT_ID=
# 2) קריאת המספר מ-GA (מתוזמנת ב-Cron כל 15 דקות; ראה vercel.json):
#    - מזהה ה-Property המספרי של GA4 (Admin → Property Settings), לא G-XXXX
GA_PROPERTY_ID=
#    - הכי קל: הדבק כאן את כל קובץ ה-JSON של ה-service account (Viewer על ה-Property):
GA_SA_JSON=
#    - לחלופין, שני שדות נפרדים מתוך אותו קובץ:
GA_SA_CLIENT_EMAIL=
GA_SA_PRIVATE_KEY=
# 3) מגן על ה-Cron (רשות אך מומלץ) — Vercel שולח אותו אוטומטית לקריאות המתוזמנות.
CRON_SECRET=
