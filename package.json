{
	"name": "national-gemach",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"discovery:setup": "npm --prefix automation install && npm --prefix automation exec playwright install chromium",
		"discovery:solve": "npm --prefix automation run solve --",
		"discovery:worker": "npm --prefix automation run worker --",
		"discovery:status": "npm --prefix automation run status --",
		"discovery:selftest": "npm --prefix automation run selftest --",
		"discovery:migrate": "npm --prefix automation run migrate --",
		"discovery:scan": "npm --prefix automation run scan --",
		"discovery:scan:apply": "npm --prefix automation run scan:apply --"
	},
	"devDependencies": {
		"@auth/sveltekit": "^1.11.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/postcss": "^4.2.0",
		"@types/node": "^22.20.1",
		"autoprefixer": "^10.4.24",
		"flag-icons": "^7.5.0",
		"postcss": "^8.5.6",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"svelte-i18n": "^4.0.1",
		"tailwindcss": "^4.2.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	}
}
