{
	"name": "national-gemach-automation",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "תשתית גילוי גמ\"חים אוטומטית — Playwright + Postgres. ראו README.md",
	"engines": {
		"node": ">=22.9.0"
	},
	"scripts": {
		"migrate": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/cli.ts migrate",
		"scan": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/cli.ts scan",
		"scan:apply": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/cli.ts scan --apply",
		"solve": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/cli.ts scan --headful --queries=5",
		"worker": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/cli.ts worker --apply",
		"selftest": "node --import tsx src/cli.ts selftest",
		"status": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx src/cli.ts status",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"national-gemach": "file:..",
		"pg": "^8.13.1",
		"playwright": "^1.50.0",
		"tsx": "^4.19.2"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@types/pg": "^8.11.10",
		"typescript": "^5.7.2"
	}
}
